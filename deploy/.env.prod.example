# Copy to `.env.prod` on the server and edit values.

# For domain + HTTPS (recommended):
#   SITE_ADDRESS=anthonyaiagent.works
#
# For IP only (HTTP):
#   SITE_ADDRESS=:80
SITE_ADDRESS=anthonyaiagent.works

POSTGRES_PASSWORD=change_me

# Optional: require API keys for calling /v1 endpoints (comma-separated)
RAG_API_KEYS=

# LLM backend:
# - ollama: set OLLAMA_URL + OLLAMA_MODEL (can be remote)
# - claude: set ANTHROPIC_API_KEY (+ optional CLAUDE_MODEL)
RAG_LLM_BACKEND=ollama
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b-instruct

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Retrieval defaults
RAG_ENABLE_VECTOR=1
RAG_ENABLE_RERANK=1
RAG_RERANK_BACKEND=bge
RAG_VECTOR_CANDIDATES=10
RAG_RERANK_CANDIDATES=30
RAG_WARMUP_ON_STARTUP=1

# If you want in-container rerank model (torch), set to 1 (heavier image)
INSTALL_RERANK=0

