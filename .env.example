# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag_assistant
REDIS_URL=redis://localhost:6380/0
RAW_DATA_DIR=data/raw/seed_docs

# ─────────────────────────────────────────────
# Embedding (Phase 1)
# ─────────────────────────────────────────────
EMBEDDING_MODEL=hash-bootstrap      # legacy bootstrap model (placeholder)
EMBEDDING_DIMENSION=1024
RAG_EMBED_MODEL=BAAI/bge-m3         # real model used by embed_chunks.py
RAG_ENABLE_VECTOR=1                 # enable vector search (requires real embeddings)
RAG_VECTOR_CANDIDATES=120           # how many vector neighbours to fetch

# ─────────────────────────────────────────────
# LLM Answer Generation (Phase 2)
# ─────────────────────────────────────────────

# Fallback chain: RAG_LLM_BACKEND controls which backend to try first.
#   auto     → Claude API first, then DeepSeek, then extractive (default)
#   claude   → force Claude API only
#   deepseek → force DeepSeek API only
RAG_LLM_BACKEND=auto
RAG_TEMPERATURE=0.2

# Option A: Anthropic Claude API (recommended — no local GPU needed)
# Get key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-haiku-4-5-20251001   # or claude-sonnet-4-6 for higher quality

# Option B: DeepSeek API (OpenAI-compatible, capable + low cost)
# Get key from https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat              # general V3; reasoner not needed for extractive QA
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─────────────────────────────────────────────
# Retrieval / Reranker (optional tuning)
# ─────────────────────────────────────────────
RAG_ENABLE_RERANK=0                 # set to 1 to enable BGE cross-encoder reranker
RAG_RERANK_BACKEND=heuristic        # heuristic | bge | cross_encoder
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_RERANK_CANDIDATES=80
RAG_RERANK_CACHE=1
